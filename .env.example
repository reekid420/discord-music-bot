# Discord
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id
GUILD_ID=optional_guild_id_for_dev_command_registration

# Web Dashboard
DASHBOARD_PORT=3000
# Required — the bot refuses to start without it (no insecure default)
DASHBOARD_PASSWORD=
# Set to 1 when serving the dashboard over HTTPS (behind a reverse proxy)
# DASHBOARD_SECURE_COOKIES=1

# Paths
UPLOADS_DIR=./uploads
DB_PATH=./data/miyabi.db

# TikTok (optional)
# Netscape-format cookies file for age-gated TikTok posts (export from a logged-in browser)
# TIKTOK_COOKIES_FILE=./data/tiktok-cookies.txt
